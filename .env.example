# -----------------------------------------------------------------------------
# Miracle International API - environment configuration
# Copy to `.env` for local development. NEVER commit real secrets.
# In deployed environments inject these via the platform's secret manager.
# -----------------------------------------------------------------------------

# development | test | staging | production
APP_ENV=development
APP_HOST=0.0.0.0
APP_PORT=8080
# Max request body in bytes (uploads use presigned URLs, not this limit)
APP_REQUEST_BODY_LIMIT=2097152
# Per-request timeout in seconds
APP_REQUEST_TIMEOUT=30
# Expose Swagger UI at /docs. Defaults to true only in development.
APP_API_DOCS_ENABLED=true

# pretty | json
LOG_FORMAT=pretty
# Standard tracing filter syntax, e.g. "info,sqlx=warn,miracle_backend=debug"
LOG_LEVEL=info,sqlx=warn,tower_http=info

DATABASE_URL=postgres://miracle:miracle@localhost:5432/miracle
DATABASE_MAX_CONNECTIONS=20
DATABASE_MIN_CONNECTIONS=2
DATABASE_ACQUIRE_TIMEOUT=5
# Apply pending migrations on startup. Keep false in production; run `miracle_backend migrate` as a pre-deploy job.
DATABASE_RUN_MIGRATIONS=true

# Integration tests: run with DATABASE_URL pointing at a TEST server/database, e.g.
#   DATABASE_URL=postgres://miracle:miracle@localhost:5432/miracle_test cargo test -- --include-ignored
# `#[sqlx::test]` creates and drops a fresh database per test on that server.

REDIS_URL=redis://localhost:6379

# Minimum 32 bytes. Generate with: openssl rand -base64 48
JWT_SECRET=change-me-to-a-long-random-secret-at-least-32-bytes
JWT_ISSUER=miracle-api
# Seconds
JWT_ACCESS_TTL=900
JWT_REFRESH_TTL=2592000

# S3-compatible object storage (MinIO locally). Optional until the documents module is enabled.
S3_ENDPOINT=http://localhost:9000
S3_BUCKET=miracle-dev
S3_REGION=us-east-1
S3_ACCESS_KEY=miracle
S3_SECRET_KEY=miracle-secret

# Comma-separated list of allowed browser origins. "*" is rejected outside development.
FRONTEND_URL=http://localhost:3000

# Background job worker
JOBS_ENABLED=true
JOBS_POLL_INTERVAL_MS=1000
JOBS_BATCH_SIZE=10
